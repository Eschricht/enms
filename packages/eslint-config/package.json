{
  "name": "@enms/eslint-config",
  "type": "module",
  "version": "0.0.1",
  "description": "Shared ESLint flat config wrapping @antfu/eslint-config with pnpm and formatter defaults",
  "author": "Johannes Eschricht",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "peerDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-format": "^2.0.0"
  },
  "dependencies": {
    "defu": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-format": "catalog:",
    "jiti": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
